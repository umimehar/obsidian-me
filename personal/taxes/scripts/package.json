{
  "name": "taxes-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run src/build.ts",
    "catalog": "bun run src/catalog.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "biome check src && tsc --noEmit && bun test && bun run src/leaks.ts",
    "leaks": "bun run src/leaks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
