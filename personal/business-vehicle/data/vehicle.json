    "whyItRose": [
      {
        "driver": "5 Year New Vehicle Protection more than doubled",
        "detail": "$303 to $794. The endorsement pays the gap between current value and original price, so exposure grows as the car depreciates. Expect another increase next year.",
        "delta": 491
      },
      {
        "driver": "$253 of newly itemised accident benefits",
        "detail": "Ontario's 2026-07-01 reform (O. Reg. 383/24) unbundled income replacement, non-earner, caregiver, death and funeral from the mandatory package. Desjardins carried them forward under OPCF 47R and now prices them separately. On the 2025-26 certificate every optional accident benefit line read Not included, because those benefits sat inside the mandatory Standard Benefits premium.",
        "delta": 253
      },
      {
        "driver": "Comprehensive up 19.6%, faster than collision",
        "detail": "Consistent with the GTA Mercedes theft loading.",
        "delta": 163
      },
      {
        "driver": "Collision up 11.3%",
        "detail": "No rating factor changed to explain it.",
        "delta": 244
      },
      {
        "driver": "DCPD up 4.8%",
        "detail": "Still the single largest line at $3,211.",
        "delta": 146
      }
